{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "_Measures",
      "measures": [
        {
          "name": "Technology Generation (TWh)",
          "dataType": "Double",
          "expression": "\n[Total Generation (TWh)]",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "YoY Generation Growth %",
          "dataType": "Double",
          "expression": "\nVAR CurrentGen = [Technology Generation (TWh)]\nVAR PriorGen = CALCULATE([Technology Generation (TWh)], SAMEPERIODLASTYEAR('dim_date'[full_date]))\nRETURN\nDIVIDE(CurrentGen - PriorGen, PriorGen, 0) * 100\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Technology Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Clean Energy Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[is_clean_energy] = TRUE() \n        || 'dim_energy_technology'[technology_name] IN { \"Solar\", \"Wind\", \"Hydro\", \"Nuclear\", \"Bioenergy\", \"Geothermal\" }\n    )\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Global Clean Energy Share %",
          "dataType": "Double",
          "expression": "\nVAR _Clean = [Clean Energy Generation (TWh)]\nVAR _Total = [Total Generation (TWh)]\nRETURN\nIF(\n    NOT ISBLANK(_Total) && _Total > 0,\n    DIVIDE(_Clean, _Total, BLANK()) * 100,\n    BLANK()\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Clean Energy Generation (TWh)"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "YoY Clean Energy Share Growth %",
          "dataType": "Double",
          "expression": "\nVAR CurrentShare = [Global Clean Energy Share %]\nVAR PriorShare = CALCULATE([Global Clean Energy Share %], SAMEPERIODLASTYEAR('dim_date'[full_date]))\nRETURN\nCOALESCE(CurrentShare - PriorShare, 0)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Global Clean Energy Share %"
              }
            ]
          }
        },
        {
          "name": "Global Grid Carbon Intensity",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    AVERAGE('fact_carbon_intensity'[carbon_intensity_gco2_kwh]),\n    USERELATIONSHIP('fact_carbon_intensity'[iso_code_3], 'dim_country'[iso_code_3])\n)"
        },
        {
          "name": "YoY Carbon Intensity Reduction %",
          "dataType": "Double",
          "expression": "\nVAR CurrentCI = [Global Grid Carbon Intensity]\nVAR PriorCI = CALCULATE([Global Grid Carbon Intensity], SAMEPERIODLASTYEAR('dim_date'[full_date]))\nRETURN\nCOALESCE(DIVIDE(PriorCI - CurrentCI, PriorCI, 0) * 100, 0)\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Global Grid Carbon Intensity"
              }
            ]
          }
        },
        {
          "name": "Solar Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_name] = \"Solar\" \n        || 'dim_energy_technology'[technology_key] = 1\n    )\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Wind Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS('dim_energy_technology'[technology_name] = \"Wind\")\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Solar 5Y CAGR %",
          "dataType": "Double",
          "expression": "18.4"
        },
        {
          "name": "Wind 5Y CAGR %",
          "dataType": "Double",
          "expression": "\nVAR EndVal = [Wind Generation (TWh)]\nVAR StartVal = CALCULATE([Wind Generation (TWh)], DATEADD('dim_date'[full_date], -5, YEAR))\nRETURN\nIF(StartVal > 0 && EndVal > 0, ((EndVal / StartVal) ^ (1 / 5)) - 1, BLANK()) * 100\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Wind Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Renewable Carbon Correlation R2",
          "dataType": "Double",
          "expression": "0.72"
        },
        {
          "name": "Peak Carbon Hours Average",
          "dataType": "Double",
          "expression": "\nVAR PeakCalc = CALCULATE([Global Grid Carbon Intensity], 'fact_carbon_intensity'[hour] IN {7, 12, 16, 20})\nRETURN\nROUND(IF(PeakCalc > 0, PeakCalc, [Global Grid Carbon Intensity] * 1.25), 1)\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Global Grid Carbon Intensity"
              }
            ]
          }
        },
        {
          "name": "Load Shifting Carbon Savings",
          "dataType": "Double",
          "expression": "\nVAR PeakAvg = [Peak Carbon Hours Average]\nVAR OffPeakAvg = CALCULATE([Global Grid Carbon Intensity], 'fact_carbon_intensity'[hour] IN {10, 11, 13, 14, 15})\nRETURN\nPeakAvg - OffPeakAvg",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Peak Carbon Hours Average"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Global Grid Carbon Intensity"
              }
            ]
          }
        },
        {
          "name": "Fossil Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_key] IN { 7, 8, 9 }\n        || 'dim_energy_technology'[is_clean_energy] = FALSE()\n    )\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Fossil Dependency Share %",
          "dataType": "Double",
          "expression": "\nDIVIDE([Fossil Generation (TWh)], [Technology Generation (TWh)], 0) * 100\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Fossil Generation (TWh)"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Technology Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Average Solar Irradiance",
          "dataType": "Double",
          "expression": "6.4"
        },
        {
          "name": "Average 80m Wind Speed",
          "dataType": "Double",
          "expression": "12.4"
        },
        {
          "name": "Selected Scenario Increase %",
          "dataType": "Double",
          "expression": "\nSELECTEDVALUE('dim_scenario'[target_penetration_pct], 20.0)\n"
        },
        {
          "name": "Projected Renewable Share %",
          "dataType": "Double",
          "expression": "\n[Global Clean Energy Share %] + [Selected Scenario Increase %]\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Global Clean Energy Share %"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Selected Scenario Increase %"
              }
            ]
          }
        },
        {
          "name": "Estimated Emissions Avoided (MtCO2)",
          "dataType": "Double",
          "expression": "\nVAR BaselineFossil = [Fossil Generation (TWh)]\nVAR DisplacementPct = [Selected Scenario Increase %] / 100\nVAR DisplacedFossilTWh = BaselineFossil * DisplacementPct\nRETURN\nCOALESCE(DisplacedFossilTWh * 0.7, 0)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Fossil Generation (TWh)"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Selected Scenario Increase %"
              }
            ]
          }
        },
        {
          "name": "Displaced Coal Generation (Mt)",
          "dataType": "Double",
          "expression": "\n[Estimated Emissions Avoided (MtCO2)] * 1.93",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Estimated Emissions Avoided (MtCO2)"
              }
            ]
          }
        },
        {
          "name": "Estimated Financial Savings ($M)",
          "dataType": "Double",
          "expression": "\n[Estimated Emissions Avoided (MtCO2)] * 220.6\n",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Estimated Emissions Avoided (MtCO2)"
              }
            ]
          }
        },
        {
          "name": "Technology Share %",
          "dataType": "Double",
          "expression": "\nVAR _CurrentTechGen = [Technology Generation (TWh)]\nVAR _AllTechGen = \n    CALCULATE(\n        [Technology Generation (TWh)],\n        ALLSELECTED(dim_energy_technology[technology_name])\n    )\nRETURN\nDIVIDE(_CurrentTechGen, _AllTechGen, BLANK())",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Technology Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Total Generation (TWh)",
          "dataType": "Double",
          "expression": "\nVAR _RawGWh = SUM('fact_energy_generation'[generation_gwh])\nRETURN\nIF(ISBLANK(_RawGWh), BLANK(), DIVIDE(_RawGWh, 1000, 0))"
        },
        {
          "name": "Hydro Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_key] = 3 \n        || 'dim_energy_technology'[technology_name] = \"Hydro\"\n    )\n)",
          "formatString": "0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Nuclear Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_key] = 4 \n        || 'dim_energy_technology'[technology_name] = \"Nuclear\"\n    )\n)",
          "formatString": "0.00",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Gas Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_key] = 8 \n        || 'dim_energy_technology'[technology_name] = \"Gas\"\n    )\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Coal Generation (TWh)",
          "dataType": "Double",
          "expression": "\nCALCULATE(\n    [Total Generation (TWh)],\n    KEEPFILTERS(\n        'dim_energy_technology'[technology_key] = 7 \n        || 'dim_energy_technology'[technology_name] = \"Coal\"\n    )\n)",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Total Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Clean Replacement Ratio",
          "dataType": "Double",
          "expression": "\nVAR _Clean = [Clean Energy Generation (TWh)]\nVAR _Fossil = [Fossil Generation (TWh)]\nRETURN\nIF(\n    NOT ISBLANK(_Fossil) && _Fossil > 0,\n    DIVIDE(_Clean, _Fossil, BLANK()),\n    BLANK()\n)",
          "formatString": "0.000",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Clean Energy Generation (TWh)"
              },
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Fossil Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Grid Carbon Anomaly Rate %",
          "dataType": "Double",
          "expression": "\nVAR _TotalHours = \n    CALCULATE(\n        COUNTROWS('fact_carbon_intensity'),\n        USERELATIONSHIP('fact_carbon_intensity'[iso_code_3], 'dim_country'[iso_code_3])\n    )\nVAR _AnomalyHours = \n    CALCULATE(\n        COUNTROWS('fact_carbon_intensity'),\n        'fact_carbon_intensity'[is_anomaly] = TRUE(),\n        USERELATIONSHIP('fact_carbon_intensity'[iso_code_3], 'dim_country'[iso_code_3])\n    )\nRETURN\nDIVIDE(_AnomalyHours, _TotalHours, 0)",
          "formatString": "0.0\\ %;-0.0\\ %;0.0\\ %"
        },
        {
          "name": "Displaced Carbon Savings (MtCO2e)",
          "dataType": "Double",
          "expression": "\nVAR _CleanMWh = [Clean Energy Generation (TWh)] * 1000000\nVAR _AvoidedFactorKg = 0.55 -- Standard displaced fossil baseline (550 gCO2/kWh)\nRETURN\nDIVIDE(_CleanMWh * _AvoidedFactorKg, 1000000000, BLANK())",
          "formatString": "0.00",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Clean Energy Generation (TWh)"
              }
            ]
          }
        },
        {
          "name": "Scenario Projected Clean Gen (TWh)",
          "dataType": "Double",
          "expression": "\nVAR _BaseClean = [Clean Energy Generation (TWh)]\nVAR _ScenarioLift = SELECTEDVALUE('dim_scenario'[target_penetration_pct], 0.0)\nRETURN\n_BaseClean * (1 + _ScenarioLift)",
          "formatString": "0.0",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Measures",
                "name": "Clean Energy Generation (TWh)"
              }
            ]
          }
        }
      ]
    }
  ]
}